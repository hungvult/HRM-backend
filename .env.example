DB_URL=jdbc:postgresql://localhost:5432/hrm
DB_USERNAME=postgres
DB_PASSWORD=1234

# Bắt buộc cho check-in/check-out. Thay bằng IP egress thực tế của Wi-Fi công ty
# và ID bản ghi work_location_wifi_networks tương ứng trong database.
APP_ATTENDANCE_TRUSTED_SOURCES_0_CIDR=<PUBLIC_IP_WIFI>/32
#ID của wifi staff đã khớp với db test
APP_ATTENDANCE_TRUSTED_SOURCES_0_WIFI_NETWORK_ID=2

# Ngưỡng kiểm tra chất lượng GPS. Backend dùng giờ server để đối chiếu
# locationCapturedAt; không dùng giờ client để chấm công.
APP_ATTENDANCE_MAX_GPS_ACCURACY_METERS=50
APP_ATTENDANCE_MAX_LOCATION_AGE_SECONDS=60
APP_ATTENDANCE_MAX_FUTURE_LOCATION_SECONDS=15

# Chỉ khai báo khi backend nằm sau Nginx/reverse proxy. Dùng IP hoặc CIDR dành
# riêng cho container Nginx; không dùng Docker gateway dùng chung.
APP_ATTENDANCE_TRUSTED_PROXIES_0_CIDR=<IP_NGINX_NOI_BO>/32
